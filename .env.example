# Copy to .env.local for local development. Never put real secrets or real data here.

# development | preview | production. Anything but production shows the synthetic-data banner.
APP_ENV=development

# No phone-home (SC-A2.6): turns off Next.js telemetry for builds, `next start`, and the dev
# server. The `next dev` launcher sends one event at shutdown before it reads this file, so also
# run `pnpm exec next telemetry disable` once per machine (or export the variable in your shell).
NEXT_TELEMETRY_DISABLED=1

# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://denialdesk:denialdesk-local-only@localhost:5432/denialdesk

# AES-256 key for field-level encryption of member IDs and MFA secrets (R-7.3.3).
# Generate your own: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# EHR/PM integrations (docs/specs/patient-integrations.md): HTTPS ports a FHIR base URL may use
# besides the default, comma-separated. Default 443 only.
# INTEGRATION_ALLOWED_PORTS=443

# Pre-production only (local, CI, Netlify): the one shared ES384 key DenialDesk signs FHIR client
# assertions with, as a PKCS#8 PEM. On Netlify set it as a functions-only secret. Leave EMPTY to
# switch Test connection and /.well-known/jwks.json off. Register this key ONLY with vendor sandbox
# tenants holding synthetic data, NEVER with a live practice EHR. Never set it in production: production
# refuses to start integrations if it is present (Key Vault only, R-7.3.5). Never commit a value.
# Generate: openssl ecparam -name secp384r1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
INTEGRATION_SIGNING_KEY=
